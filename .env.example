DATABASE_URL=postgres://user:password@localhost:5432/bridge
REDIS_URL=redis://localhost:6379
# DB_POOL_MAX=20                # Postgres pool per process. On RDS keep the sum
#                               # over all roles well below max_connections.

# Solana
HELIUS_URL=https://mainnet.helius-rpc.com/?api-key=<key>
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=<key>
SOLANA_TOKEN_BRIDGE_PROGRAM=<token bridge program address>

EVM_WATCH_ENABLED=1
EVM_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/<key>
EVM_RPC_BASE=https://lb.drpc.live/base/<key>
EVM_RPC_ARBITRUM=https://lb.drpc.live/arbitrum/<key>
EVM_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc

# Optional
WORMHOLE_URL=https://api.wormholescan.io
PORT=8080
METRICS_PORT=9100
ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info

# Server-owned live feed: a bounded Redis ring filled by the indexer, read by
# GET /api/v2/transfers/live. Off by default; when off, the endpoint 404s and no
# Redis command is issued for the feed.
# LIVE_FEED_REDIS_ENABLED=1
# LIVE_FEED_MAX=1000             # frames kept in the ring (1..10000)

# Helius lanes: a separate key per lane so the API and the ingestion pipeline
# don't share a plan quota. Each falls back to HELIUS_URL when unset.
# HELIUS_API_URL=               # /analyse and the list endpoint
# HELIUS_STREAM_URL=            # ingester backfill, consumer workers, re-enrichment
#                               # (HELIUS_LIVE_URL is the deprecated name for this)
# HELIUS_API_RPS=6              # per-lane requests/sec; with one shared key the two
# HELIUS_LIVE_RPS=4             # must add up to the plan limit (free plan: 10)


# Solana ingestion is always on (A8). All optional.
# INGEST_ENABLED=1              # 0 disables the ingester (kill switch)
# INGEST_SOURCE=logs            # logs (logsSubscribe, default) or laserstream
#                               # (experimental; build with --features laserstream)
# HELIUS_API_KEY=               # LaserStream only. Leave empty here; export it.
# LASERSTREAM_ENDPOINT=https://laserstream-devnet-ewr.helius-rpc.com
# LIVE_BACKFILL=1               # replay signatures missed since the checkpoint on every (re)connect
# INGEST_BACKFILL_MAX=5000      # most signatures one backfill run publishes
# INGEST_BACKFILL_PACE_MS=750   # pause between backfilled signatures, so publishing
#                               # stays under the live Helius limiter (~4 calls/s)
# INGEST_REWIND_SLOTS=20        # start the backfill this many slots before the
#                               # checkpoint, so its own slot is not missed
# INGEST_DEDUPE_TTL_SECS=7200   # remember published signatures this long, 0 disables
# INGEST_POLL_SECS=300          # reconcile poll interval per program, minimum 30
# INGEST_POLL_OVERLAP_SECS=600  # re-scan this much before the last window's end
# INGEST_POLL_OFFSET_SECS=180   # keep the window this far behind the wall clock
# INGEST_POLL_MAX_PUBLISH=500   # most missing signatures one cycle republishes
# INGEST_PING_SECS=30           # WebSocket ping interval
# INGEST_WATCHDOG_SECS=90       # reconnect after no frame of any kind for this long
#                               # (must stay above INGEST_PING_SECS)

# Stream consumer and recovery worker (all optional)
# CONSUMER_COUNT=5                 # worker tasks reading the stream
# CONSUMER_READ_COUNT=10           # XREADGROUP COUNT per worker
# HELIUS_LIVE_TOKEN_WAIT_MS=20000  # how long a worker waits for its first Helius token
# WORKER_MAX_DELIVERIES=10         # deliveries before a transiently failing message is dead-lettered
# WORKER_RECLAIM_IDLE_MS=300000    # unacked time before recovery reclaims a message
# WORKER_RECLAIM_INTERVAL_SECS=30  # how often recovery sweeps

# Background re-enrichment of Detected and Pending transfers (all optional)
# REENRICH_ENABLED=1
# REENRICH_INTERVAL_SECS=30
# REENRICH_BATCH=50
# REENRICH_MIN_AGE_SECS=60
# REENRICH_RETRY_SECS=120
# REENRICH_MAX_AGE_SECS=604800

# How often the chain registry reloads from Postgres (optional, default 60, minimum 5)
# CHAIN_REGISTRY_REFRESH_SECS=60

# EVM log watching: fills source/destination tx hashes from Wormhole logs on the
# destination EVM chain, so WormholeScan is not called for watched chains. One
# EVM_RPC_<CHAIN> per watched chain; the suffix is the chain registry slug in upper
# case. EVM_RPC_<CHAIN>_FALLBACK is an optional second endpoint; the watcher fails
# over to it on 429, timeout and 5xx. Targets (contract addresses, finality depth and
# the expected eth_chainId) live in evm_watch_targets and are seeded for Ethereum,
# Base, Arbitrum and Avalanche by the migrations. No variable names a provider.
# EVM_WATCH_ENABLED=1
# EVM_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/<key>
# EVM_RPC_ETHEREUM_FALLBACK=https://lb.drpc.live/ethereum/<key>
# EVM_RPC_BASE=https://lb.drpc.live/base/<key>
# EVM_RPC_BASE_FALLBACK=https://base-mainnet.g.alchemy.com/v2/<key>
# EVM_RPC_ARBITRUM=https://lb.drpc.live/arbitrum/<key>
# EVM_RPC_ARBITRUM_FALLBACK=https://arb-mainnet.g.alchemy.com/v2/<key>
# EVM_RPC_AVALANCHE=https://api.avax.network/ext/bc/C/rpc
# EVM_RPC_AVALANCHE_FALLBACK=https://avax-mainnet.g.alchemy.com/v2/<key>
# EVM_RPS=5                     # default requests/sec for one endpoint; each
#                               # endpoint has its own limiter, not one shared budget
# EVM_POLL_SECS=12              # pause between polls
# EVM_MAX_BLOCK_RANGE=10        # default eth_getLogs blocks per request; halved on
#                               # a genuine range-too-large answer, per endpoint
# EVM_JOIN_MAX_AGE_SECS=86400   # how long an unmatched event is retried against
#                               # transfers; the row-level lookup has no age limit
#
# Per-endpoint overrides (optional; default to EVM_RPS and EVM_MAX_BLOCK_RANGE).
# The E0 measurements in docs/scaling-log.md give the values to use: 10 for
# Alchemy free, 101 for dRPC free, 100 for the keyless Avalanche public endpoint.
# E0 measured range caps, not request rates, so no RPS override is set; all
# endpoints use EVM_RPS unless a plan documents a different limit.
# EVM_RPC_ETHEREUM_MAX_RANGE=101
# EVM_RPC_ETHEREUM_RPS=5
# EVM_RPC_ETHEREUM_FALLBACK_MAX_RANGE=10
# EVM_RPC_ETHEREUM_FALLBACK_RPS=5
# EVM_RPC_BASE_MAX_RANGE=101
# EVM_RPC_BASE_FALLBACK_MAX_RANGE=10
# EVM_RPC_ARBITRUM_MAX_RANGE=101
# EVM_RPC_ARBITRUM_FALLBACK_MAX_RANGE=10
# EVM_RPC_AVALANCHE_MAX_RANGE=100
# EVM_RPC_AVALANCHE_FALLBACK_MAX_RANGE=10

# ROLE=all|api|stream
# HELIUS_RECONCILE_URL and RECONCILE_RPS
# HEALTH_MAX_INGEST_AGE_SECS